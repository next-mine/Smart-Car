	//   锟斤拷锟斤拷锟街诧拷锟斤拷锟斤拷锟侥地凤拷锟矫空革拷锟诫，锟斤拷锟斤拷占位锟斤拷锟斤拷锟角固讹拷锟侥ｏ拷锟斤拷锟斤拷吮锟斤拷锟斤拷锟斤拷锟?
	//        x + (占位锟斤拷锟斤拷 - 1) * 8 < 160
	//   锟斤拷锟斤拷 tft180_show_string 锟斤拷锟? zf_assert(x < tft180_x_max) 锟斤拷锟斤拷锟绞э拷埽锟街憋拷影殉锟斤拷锟酵Ｗ★拷锟?
	//   锟侥讹拷锟斤拷锟斤拷锟轿猴拷锟斤拷锟斤拷前锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟绞斤拷锟斤拷锟揭伙拷椤?
	//
	// 锟斤拷幕锟斤拷锟捷讹拷锟秸憋拷锟斤拷锟斤拷锟斤拷锟芥）锟斤拷
	//   DianCi_demo              锟斤拷锟斤拷锟斤拷
	//   R0:1234   N:56           锟斤拷0路锟斤拷校锟絉=原始值(0~4095) / N=锟斤拷一锟斤拷值(0~100)
	//   R1:2345   N:60           R0~R3 锟斤拷锟轿讹拷应 ADC_CHANNEL1~4锟斤拷锟斤拷锟斤拷 -> 锟斤拷锟揭ｏ拷
	//   R2:3456   N:40
	//   R3:4567   N:33
	//   E:-1234  TGT:100.0       E   = 锟斤拷群锟狡?锟筋（锟斤拷4000锟斤拷锟斤拷 = 锟斤拷锟斤拷偏锟斤拷
	//                            TGT = 目锟斤拷锟劫度ｏ拷锟斤拷锟斤拷/锟斤拷锟节ｏ拷
	//   SPD:100.0  Loop:0        SPD  = 实锟斤拷锟劫度ｏ拷锟斤拷锟斤拷/锟斤拷锟节ｏ拷
	//                            Loop = 锟秸伙拷锟斤拷锟截ｏ拷0 = 锟斤拷锟斤拷 / 1 = 锟秸伙拷锟斤拷锟斤拷锟斤拷锟斤拷锟节筹拷锟斤拷锟斤拷只写一锟斤拷
	//   DUTY:10  LOST:0  F:0     DUTY = 锟斤拷锟秸硷拷毡锟?(%)
	//                            LOST = 锟斤拷锟竭憋拷志锟斤拷1 = 锟斤拷锟揭碉拷锟揭伙拷锟斤拷撸锟?
	//                            F    = 锟劫度伙拷锟斤拷锟较ｏ拷1 = 锟斤拷獾斤拷锟斤拷锟斤拷锟斤拷锟斤拷斐ｏ拷锟斤拷锟斤拷锟斤拷锟斤拷 0锟斤拷
	tft180_show_string(0,   0, "DianCi_demo");
	tft180_show_string(0,  16, "R0:");
	tft180_show_string(64, 16, "N:");
	tft180_show_string(0,  32, "R1:");
	tft180_show_string(64, 32, "N:");
	tft180_show_string(0,  48, "R2:");
	tft180_show_string(64, 48, "N:");
	tft180_show_string(0,  64, "R3:");
	tft180_show_string(64, 64, "N:");
	tft180_show_string(0,  80, "E:");
	tft180_show_string(72, 80, "TGT:");
	tft180_show_string(0,  96, "SPD:");
	tft180_show_string(88, 96, "Loop:");
	tft180_show_string(0, 112, "DUTY:");
	tft180_show_string(72,112, "LOST:");
	tft180_show_string(128,112,"F:");
	// Loop 锟角憋拷锟斤拷锟节筹拷锟斤拷锟斤拷锟斤拷锟斤拷锟节诧拷锟斤拷洌?锟斤拷锟斤拷只写一锟轿ｏ拷锟斤拷锟斤拷"为什么锟斤拷锟斤拷锟斤拷锟秸伙拷"一锟桔撅拷锟杰匡拷锟斤拷锟斤拷
	tft180_show_int(128, 96, SPEED_LOOP_ENABLE, 1);
	
    while(1)
    {
        // 锟剿达拷锟斤拷写锟斤拷要循锟斤拷执锟叫的达拷锟斤拷
		// 4 路锟斤拷校锟斤拷锟斤拷锟斤拷锟剿诧拷锟斤拷锟皆?始值锟斤拷锟斤拷锟斤拷锟疥定 adc_min/adc_max锟斤拷锟斤拷锟揭憋拷锟角癸拷一锟斤拷值 0~100
        tft180_show_int(24, 16, adc_buffer[0], 4);
        tft180_show_int(80, 16, adc_normal[0], 3);
		
        tft180_show_int(24, 32, adc_buffer[1], 4);
        tft180_show_int(80, 32, adc_normal[1], 3);
		
		tft180_show_int(24, 48, adc_buffer[2], 4);
        tft180_show_int(80, 48, adc_normal[2], 3);
		
		tft180_show_int(24, 64, adc_buffer[3], 4);
        tft180_show_int(80, 64, adc_normal[3], 3);
		
		tft180_show_float(16, 80, adc_error, 4, 1);					// E   = 锟斤拷群锟狡?锟筋，锟斤拷锟斤拷 锟斤拷4000
		tft180_show_float(104, 80, speed_target, 4, 1);				// TGT = 目锟斤拷锟劫讹拷
		
		tft180_show_float(32, 96, speed_now, 4, 1);					// SPD = 实锟斤拷锟劫度ｏ拷锟斤拷锟斤拷/锟斤拷锟节ｏ拷
		
		tft180_show_int(40, 112, duty, 3);							// DUTY = 锟斤拷前占锟秸憋拷(%)
		tft180_show_int(112, 112, line_lost_flag, 1);				// LOST = 锟斤拷锟竭憋拷志
		tft180_show_int(144, 112, speed_fault, 1);					// F    = 锟劫度伙拷锟斤拷锟较憋拷志
        
        // 锟剿达拷锟斤拷写锟斤拷要循锟斤拷执锟叫的达拷锟斤拷
    }
}

//锟剿筹拷始锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷始锟斤拷4路锟斤拷锟斤拷涌冢锟?4路锟斤拷锟斤拷锟斤拷锟接口ｏ拷4路锟斤拷锟紸DC锟斤拷3路锟斤拷锟斤拷涌冢锟斤拷约锟斤拷锟揭伙拷锟斤拷甓ㄖ?
void Init_All(void)
{
	//锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷锟紻RV8701
	gpio_init(MOTOR1_DIR, GPO, GPIO_HIGH, GPO_PUSH_PULL);                            // GPIO 锟斤拷始锟斤拷为锟斤拷锟? 默锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟?
    pwm_init(MOTOR1_PWM, 17000, 0);                                                  // PWM 通锟斤拷锟斤拷始锟斤拷频锟斤拷 17KHz 占锟秸比筹拷始为 0
    
    gpio_init(MOTOR2_DIR, GPO, GPIO_HIGH, GPO_PUSH_PULL);                            // GPIO 锟斤拷始锟斤拷为锟斤拷锟? 默锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟?
    pwm_init(MOTOR2_PWM, 17000, 0);                                                  // PWM 通锟斤拷锟斤拷始锟斤拷频锟斤拷 17KHz 占锟秸比筹拷始为 0

    gpio_init(MOTOR3_DIR, GPO, GPIO_HIGH, GPO_PUSH_PULL);                            // GPIO 锟斤拷始锟斤拷为锟斤拷锟? 默锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟?
    pwm_init(MOTOR3_PWM, 17000, 0);                                                  // PWM 通锟斤拷锟斤拷始锟斤拷频锟斤拷 17KHz 占锟秸比筹拷始为 0

    gpio_init(MOTOR4_DIR, GPO, GPIO_HIGH, GPO_PUSH_PULL);                            // GPIO 锟斤拷始锟斤拷为锟斤拷锟? 默锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟?
    pwm_init(MOTOR4_PWM, 17000, 0);                                                  // PWM 通锟斤拷锟斤拷始锟斤拷频锟斤拷 17KHz 占锟秸比筹拷始为 0

	//锟斤拷锟捷憋拷锟斤拷锟斤拷锟斤拷锟酵和革拷锟斤拷选锟斤拷锟绞硷拷锟斤拷锟斤拷锟?
	//锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷
    encoder_quad_init(ENCODER_1, ENCODER_1_A, ENCODER_1_B); // 锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷模锟斤拷锟斤拷锟斤拷锟斤拷 锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟侥Ｊ?
    encoder_quad_init(ENCODER_2, ENCODER_2_A, ENCODER_2_B); // 锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷模锟斤拷锟斤拷锟斤拷锟斤拷 锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟侥Ｊ?
    encoder_quad_init(ENCODER_3, ENCODER_3_A, ENCODER_3_B); // 锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷模锟斤拷锟斤拷锟斤拷锟斤拷 锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟侥Ｊ?
    encoder_quad_init(ENCODER_4, ENCODER_4_A, ENCODER_4_B); // 锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷模锟斤拷锟斤拷锟斤拷锟斤拷 锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟侥Ｊ?
	
	//锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷
//    encoder_dir_init(ENCODER_1, ENCODER_1_A, ENCODER_1_B); // 锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷模锟斤拷锟斤拷锟斤拷锟斤拷
//    encoder_dir_init(ENCODER_2, ENCODER_2_A, ENCODER_2_B); // 锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷模锟斤拷锟斤拷锟斤拷锟斤拷
//    encoder_dir_init(ENCODER_3, ENCODER_3_A, ENCODER_3_B); // 锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷模锟斤拷锟斤拷锟斤拷锟斤拷
//    encoder_dir_init(ENCODER_4, ENCODER_4_A, ENCODER_4_B); // 锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷模锟斤拷锟斤拷锟斤拷锟斤拷
	
	//锟斤拷始锟斤拷adc锟斤拷锟斤拷
	adc_init(ADC_CHANNEL1, ADC_12BIT);                                          // 锟斤拷始锟斤拷锟斤拷应 ADC 通锟斤拷为锟斤拷应锟斤拷锟斤拷
    adc_init(ADC_CHANNEL2, ADC_12BIT);                                          // 锟斤拷始锟斤拷锟斤拷应 ADC 通锟斤拷为锟斤拷应锟斤拷锟斤拷
    adc_init(ADC_CHANNEL3, ADC_12BIT);                                          // 锟斤拷始锟斤拷锟斤拷应 ADC 通锟斤拷为锟斤拷应锟斤拷锟斤拷
    adc_init(ADC_CHANNEL4, ADC_12BIT);                                          // 锟斤拷始锟斤拷锟斤拷应 ADC 通锟斤拷为锟斤拷应锟斤拷锟斤拷
		
	//锟斤拷始锟斤拷锟斤拷锟斤拷锟斤拷锟?
    pwm_init(SERVO_MOTOR1_PWM, SERVO_MOTOR_FREQ, 0);
    pwm_init(SERVO_MOTOR2_PWM, SERVO_MOTOR_FREQ, 0);
    pwm_init(SERVO_MOTOR3_PWM, SERVO_MOTOR_FREQ, 0);
	
	//锟斤拷始锟斤拷锟斤拷一锟斤拷锟疥定值锟斤拷锟斤拷锟斤拷锟节匡拷锟叫讹拷之前锟斤拷锟斤拷锟叫讹拷锟斤拷锟揭伙拷锟斤拷芄锟揭伙拷锟斤拷突锟斤拷玫锟? adc_min/adc_max锟斤拷
	// 锟斤拷锟斤拷锟绞憋拷锟斤拷腔锟斤拷锟? 0锟斤拷锟斤拷值锟斤拷锟斤拷锟斤拷锟? 0锟斤拷锟斤拷一锟斤拷锟斤拷锟斤拷 span<=0 锟侥憋拷锟斤拷锟斤拷支锟斤拷锟斤拷幕锟斤拷前锟斤拷帧全锟斤拷 0锟斤拷
	get_data_init();
}

//锟叫断猴拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷锟叫筹拷始锟斤拷为每10ms执锟斤拷一锟斤拷
void pit_handler (void)
{
	
	get_data();//锟斤拷取锟斤拷锟斤拷锟斤拷锟斤拷锟捷ｏ拷锟斤拷锟斤拷锟斤拷锟斤拷锟斤拷 + 锟斤拷锟斤拷瞬锟?/锟斤拷一锟斤拷/锟斤拷群停锟?
	set_servo_pwm();//锟斤拷锟矫讹拷锟斤拷锟斤拷
	set_speed_pwm();//锟斤拷锟矫碉拷锟斤拷俣龋锟斤拷锟斤拷锟斤拷锟斤拷栈锟斤拷锟?
	
}
